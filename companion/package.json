{
  "name": "@claude-desk-display/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.cjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "format": "prettier --write src scripts package.json tsconfig.json ../README.md ../AGENTS.md ../docs/**/*.md",
    "format:check": "prettier --check src scripts package.json tsconfig.json ../README.md ../AGENTS.md ../docs/**/*.md",
    "setup": "npm run build && node dist/cli/setup.js install",
    "uninstall": "npm run build && node dist/cli/setup.js uninstall"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
